# Copia este ficheiro para ".env" e ajusta os valores conforme a tua VM.
#
# Se o MySQL corre dentro de uma máquina virtual (VM) e não no teu PC,
# NÃO uses "localhost" — usa o endereço IP da VM.
#
# Como descobrir o IP da VM:
#   Linux (dentro da VM):   ip addr   ou   hostname -I
#   Windows (dentro da VM): ipconfig
#
# Nota sobre modo de rede da VM:
#   - Se a VM estiver em modo "NAT", normalmente NÃO dá para aceder por IP
#     de dentro da VM a partir do PC anfitrião a não ser que configures
#     "Port Forwarding" (redirecionar porta 3306 do PC para a porta 3306 da VM).
#   - Se a VM estiver em modo "Bridge" (rede em ponte), a VM tem um IP próprio
#     na tua rede local e podes ligar-te diretamente a esse IP.

DB_HOST=192.168.1.50
DB_USER=root
DB_PASSWORD=a_tua_password
DB_NAME=gestao_oficina

PORT=3000
DATABASE_HOST="127.0.0.1"
DATABASE_PORT=3306
DATABASE_USER=oficina
DATABASE_PASSWORD=""
DATABASE_NAME="gestao_oficina"